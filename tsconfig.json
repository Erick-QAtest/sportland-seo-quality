
{
    "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "lib": ["ES2022", "DOM"],
      "types": ["node"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "noEmit": true
    },
    "include": [
      "data/**/*.ts",
      "services/**/*.ts",
      "tests/**/*.ts",
      "playwright.config.ts"
    ],
    "exclude": [
      "node_modules",
      "playwright-report",
      "test-results"
    ]
  }
  