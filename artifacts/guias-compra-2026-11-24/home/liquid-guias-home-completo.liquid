                sizes: '(min-width: 1101px) 400px, (min-width: 750px) 50vw, 116px',
                alt: 'Guías sobre tecnologías utilizadas en tenis'
            }}

          {% else %}

            <div
              class="sportland-guide-card__placeholder sportland-guide-card__placeholder--tech"
              aria-hidden="true"
            >
              <span>TECH</span>
            </div>

          {% endif %}

        </div>


        <div class="sportland-guide-card__content">

          <span class="sportland-guide-card__category">
            TECNOLOGÍAS
          </span>

          <h3>
            ¿Qué tecnología usan tus tenis?
          </h3>

          <p>
            Entiende tecnologías como Boost, Cloudfoam,
