          </p>

          <span class="sportland-guide-card__link">

            EXPLORAR TECNOLOGÍAS

            <span aria-hidden="true">→</span>

          </span>

        </div>

      </a>


      {% comment %}
        ======================================================
        3. TALLAS
        ======================================================
      {% endcomment %}

      <a
