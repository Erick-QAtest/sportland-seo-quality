<style>

/* =========================================================
   SPORTLAND MX — GUÍAS HOME · V2
   ========================================================= */


/* ---------------------------------------------------------
   BASE
   --------------------------------------------------------- */

.sportland-guides {
  width:100%;
  box-sizing:border-box;
  padding:64px 40px;
  background:#fff;
  color:#0b1f3a;
}

.sportland-guides *,
.sportland-guides *::before,
.sportland-guides *::after {
  box-sizing:border-box;
}

.sportland-guides__inner {
  width:100%;
  max-width:1280px;
  margin:0 auto;
}


/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

.sportland-guides__header {
  display:flex;
  align-items:flex-end;
  justify-content:space-between;
  gap:32px;
  margin-bottom:30px;
}

.sportland-guides__header-copy {
  max-width:760px;
}

.sportland-guides__eyebrow {
  display:block;
  margin-bottom:8px;

  color:#697586;

  font-size:11px;
  font-weight:800;
  line-height:1.2;
  letter-spacing:.11em;
}

.sportland-guides h2 {
  margin:0;

  color:#0b1f3a;

  font-size:clamp(30px,2.7vw,42px);
  font-weight:760;
  line-height:1.06;
  letter-spacing:-.035em;

  text-wrap:balance;
}

.sportland-guides__header p {
  max-width:660px;
  margin:11px 0 0;

  color:#5f6b7a;

  font-size:15px;
  line-height:1.55;

  text-wrap:pretty;
}

.sportland-guides__all {
  display:inline-flex!important;
  flex:0 0 auto;
  align-items:center;
  gap:8px;

  min-height:40px;

  color:#0b1f3a!important;

  font-size:12px;
  font-weight:800;
  line-height:1;

  text-decoration:none!important;
  white-space:nowrap;
}

.sportland-guides__all > span {
  font-size:17px;
  transition:transform .18s ease;
}


/* ---------------------------------------------------------
   FINDER
   --------------------------------------------------------- */

.sportland-guides__finder {
  display:grid!important;

  grid-template-columns:
    minmax(0,1.08fr)
    minmax(380px,.92fr);

  min-height:390px;
  margin-bottom:34px;

  overflow:hidden;

  border-radius:18px;

  background:
    linear-gradient(
      125deg,
      #071b31 0%,
      #0c2949 100%
    );

  color:#fff!important;

  text-decoration:none!important;

  transition:
    transform .22s ease,
    box-shadow .22s ease;
}

.sportland-guides__finder:focus-visible {
  outline:3px solid #ef2634;
  outline-offset:4px;
}


/* ---------------------------------------------------------
   FINDER CONTENT
   --------------------------------------------------------- */

.sportland-guides__finder-content {
  display:flex;
  flex-direction:column;
  justify-content:center;

  padding:clamp(34px,5vw,62px);
}

.sportland-guides__finder-kicker {
  display:block;

  margin-bottom:12px;

  color:#ff6671;

  font-size:10px;
  font-weight:900;
  line-height:1.2;
  letter-spacing:.12em;
}

.sportland-guides__finder h3 {
  max-width:620px;
  margin:0;

  color:#fff;

  font-size:clamp(34px,3.5vw,50px);
  font-weight:790;
  line-height:1.01;
  letter-spacing:-.045em;

  text-wrap:balance;
}

.sportland-guides__finder h3 span {
  display:block;
}

.sportland-guides__finder-content > p {
  max-width:570px;

  margin:17px 0 0;

  color:rgba(255,255,255,.69);

  font-size:14px;
  line-height:1.6;
}


/* ---------------------------------------------------------
   FINDER TAGS
   --------------------------------------------------------- */

.sportland-guides__finder-tags {
  display:flex;
  flex-wrap:wrap;

  gap:7px;

  margin-top:23px;
}

.sportland-guides__finder-tags span {
  display:inline-flex;
  align-items:center;

  min-height:28px;

  padding:5px 10px;

  border:
    1px solid
    rgba(255,255,255,.14);

  border-radius:999px;

  background:
    rgba(255,255,255,.055);

  color:
    rgba(255,255,255,.80);

  font-size:8px;
  font-weight:800;
  letter-spacing:.07em;
}


/* ---------------------------------------------------------
   FINDER CTA
   --------------------------------------------------------- */

.sportland-guides__finder-link {
  display:inline-flex;
  align-items:center;

  gap:9px;

  width:fit-content;

  margin-top:28px;

  color:#fff;

  font-size:11px;
  font-weight:850;
  line-height:1;
  letter-spacing:.035em;
}

.sportland-guides__finder-link > span {
  font-size:18px;
  transition:transform .18s ease;
}


/* ---------------------------------------------------------
   FINDER VISUAL
   --------------------------------------------------------- */

.sportland-guides__finder-visual {
  position:relative;

  display:grid;
  place-items:center;

  min-height:390px;

  overflow:hidden;

  background:
    radial-gradient(
      circle at 50% 50%,
      rgba(255,255,255,.10),
      transparent 40%
    );
}

.sportland-finder-map {
  position:relative;

  width:min(350px,80%);

  aspect-ratio:1 / 1;

  border:
    1px solid
    rgba(255,255,255,.10);

  border-radius:50%;
}

.sportland-finder-map::before {
  content:"";

  position:absolute;
  inset:44px;

  border:
    1px solid
    rgba(255,255,255,.065);

  border-radius:50%;
}


/* ---------------------------------------------------------
   FINDER CENTER
   --------------------------------------------------------- */

.sportland-finder-map__center {
  position:absolute;

  top:50%;
