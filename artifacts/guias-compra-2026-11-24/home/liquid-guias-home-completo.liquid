            Converse, Adidas y más.
          </p>

          <span class="sportland-guide-card__link">

            EXPLORAR ORIGINALIDAD

            <span aria-hidden="true">→</span>

          </span>

        </div>

      </a>


      {% comment %}
        ======================================================
        2. TECNOLOGÍAS
        ======================================================
      {% endcomment %}

      <a
        href="{{ hub_tecnologia_url }}"
        class="sportland-guide-card sportland-guide-card--tecnologia"
      >

        <div class="sportland-guide-card__media">

          {% if guide_tecnologia.image %}

