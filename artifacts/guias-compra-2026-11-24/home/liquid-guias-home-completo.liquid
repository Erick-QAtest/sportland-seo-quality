      <a
        href="{{ hub_guias_url }}"
        class="sportland-guides__all"
      >
        VER TODAS LAS GUÍAS
        <span aria-hidden="true">→</span>
      </a>

    </div>


    {% comment %}
      ========================================================
      HUB MAESTRO / SPORTLAND FINDER
      ========================================================
    {% endcomment %}

    <a
      href="{{ hub_guias_url }}"
      class="sportland-guides__finder"
    >

      <div class="sportland-guides__finder-content">

        <span class="sportland-guides__finder-kicker">
          SPORTLAND FINDER
        </span>

        <h3>
          ¿Qué quieres resolver

          <span>
            antes de elegir?
          </span>
        </h3>

        <p>
          Empieza por tu duda y encuentra la guía adecuada
          para tomar una decisión con más información.
        </p>


        <div class="sportland-guides__finder-tags">

          <span>ORIGINALIDAD</span>
          <span>TECNOLOGÍA</span>
          <span>TALLAS</span>
          <span>CUIDADO</span>
          <span>MARCAS</span>
          <span>RESEÑAS</span>

        </div>


        <span class="sportland-guides__finder-link">

          ENCONTRAR MI GUÍA

          <span aria-hidden="true">→</span>

        </span>

      </div>


      {% comment %}
        ======================================================
        VISUAL FINDER
        Decorativo. Oculto para lectores de pantalla.
        ======================================================
      {% endcomment %}

      <div
        class="sportland-guides__finder-visual"
        aria-hidden="true"
      >

        <div class="sportland-finder-map">

          <div class="sportland-finder-map__center">
            START
          </div>


          <span class="sportland-finder-map__line sportland-finder-map__line--1"></span>
          <span class="sportland-finder-map__line sportland-finder-map__line--2"></span>
          <span class="sportland-finder-map__line sportland-finder-map__line--3"></span>
          <span class="sportland-finder-map__line sportland-finder-map__line--4"></span>
          <span class="sportland-finder-map__line sportland-finder-map__line--5"></span>
          <span class="sportland-finder-map__line sportland-finder-map__line--6"></span>


          <div class="sportland-finder-map__node sportland-finder-map__node--auth">

            <small>01</small>

            <strong>
              ORIGINALIDAD
            </strong>

            <span>
              ¿Es auténtico?
            </span>

          </div>


          <div class="sportland-finder-map__node sportland-finder-map__node--technology">

            <small>02</small>

            <strong>
              TECNOLOGÍA
            </strong>

            <span>
              ¿Cómo funciona?
            </span>

          </div>


          <div class="sportland-finder-map__node sportland-finder-map__node--size">

            <small>03</small>

            <strong>
              TALLAS
            </strong>

            <span>
              ¿Cuál necesito?
            </span>

          </div>


          <div class="sportland-finder-map__node sportland-finder-map__node--care">

            <small>04</small>

            <strong>
              CUIDADO
            </strong>

            <span>
              ¿Cómo los conservo?
            </span>

          </div>


          <div class="sportland-finder-map__node sportland-finder-map__node--brands">

            <small>05</small>

            <strong>
              MARCAS
            </strong>

            <span>
              ¿Qué quiero conocer?
            </span>

          </div>


          <div class="sportland-finder-map__node sportland-finder-map__node--reviews">

            <small>06</small>

            <strong>
              RESEÑAS
            </strong>

            <span>
              ¿Vale la pena?
            </span>

          </div>


          <div class="sportland-finder-map__result">

            <small>RESULT</small>

            <strong>
              TU GUÍA
            </strong>

          </div>

        </div>

      </div>

    </a>


    {% comment %}
      ========================================================
      HUBS PRINCIPALES
      ========================================================
    {% endcomment %}

    <div class="sportland-guides__grid">


      {% comment %}
        ======================================================
        0. ACTIVIDAD (destacada a lo ancho) · SL-HOME-HUB-ACTIVIDAD-20261124
        ======================================================
      {% endcomment %}

      <a
        href="{{ hub_actividad_url }}"
        class="sportland-guide-card sportland-guide-card--actividad"
      >

        <div class="sportland-guide-card__media">

          {% if guide_actividad.image %}

            {{
              guide_actividad.image
              | image_url: width: 1200
              | image_tag:
                loading: 'lazy',
                widths: '240, 360, 480, 640, 900, 1200',
                sizes: '(min-width: 1101px) 640px, (min-width: 750px) 50vw, 116px',
                alt: 'Guías para elegir tenis según tu deporte o actividad'
            }}

          {% else %}

            <div
              class="sportland-guide-card__placeholder"
              aria-hidden="true"
            >
              <span>SPORT</span>
            </div>

          {% endif %}

        </div>


        <div class="sportland-guide-card__content">

          <span class="sportland-guide-card__category">
            DEPORTE Y ACTIVIDAD
          </span>

          <h3>
            ¿Qué tenis necesitas para tu deporte?
          </h3>

          <p>
            Gimnasio, voleibol, tenis, pádel, CrossFit, correr
            o estar de pie: guías con video y comparativa
            de modelos para elegir según lo que haces.
          </p>

          <span class="sportland-guide-card__link">

            VER GUÍAS POR ACTIVIDAD

            <span aria-hidden="true">→</span>

          </span>

        </div>

      </a>


      {% comment %}
        ======================================================
        1. ORIGINALIDAD
        ======================================================
      {% endcomment %}

